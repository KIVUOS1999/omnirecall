{
    "manifest_version": 3,
    "name": "omnirecall",
    "version": "1.0",
    "description": "this will remember everything you see",
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": "icons/icon48.png",
        "default_width": 1000,
        "default_height": 600
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": ["tabs", "storage", "history"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content_scripts/content.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["icons/icon16.png"],
            "matches": ["<all_urls>"]
        }
    ]
}